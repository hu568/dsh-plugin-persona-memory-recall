{
    "name": "@dsh-external/dsh-persona-memory-recall",
    "version": "0.2.1",
    "description": "DSH 长期日志自动召回：每轮按本轮用户消息从 JOURNAL.jsonl 做 BM25 检索，把命中的历史片段作为一条 user 快照消息追加到上下文（不改系统提示词，不破坏 KV 缓存前缀）",
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "cordis.patch.yml",
        "README.md"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hu568/dsh-plugin-persona-memory-recall.git"
    },
    "homepage": "https://github.com/hu568/dsh-plugin-persona-memory-recall#readme",
    "bugs": {
        "url": "https://github.com/hu568/dsh-plugin-persona-memory-recall/issues"
    },
    "keywords": [
        "dsh",
        "dsh-plugin",
        "dsh-plugin-pack",
        "cordis",
        "cordis-plugin",
        "memory",
        "recall",
        "bm25"
    ],
    "peerDependencies": {
        "cordis": ">=4.0.0-rc <5"
    },
    "dependencies": {
        "schemastery": "npm:@deepseek-ai/schemastery@3.18.2"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    }
}
